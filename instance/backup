#!/usr/bin/env node

import { errorAndExit } from '${environmentRoot}/server/scripts/logger.js'
import runBackup from '${environmentRoot}/server/scripts/backup/runBackup.js'

const config = {
    awsAccessKey: '${awsAccessKey}',
    awsBucket: '${awsBucket}',
    awsEndpoint: '${awsEndpoint}',
    awsSecretKey: '${awsSecretKey}',
    databasesPassword: '${databasesPassword}',
    databasesUser: '${databasesUser}',
    home: '${home}',
    instance: '${instance}',
    storageProvider: '${storageProvider}',
}

try {
    await runBackup({
        args: process.argv.slice(2),
        config,
    })
} catch (e) {
    errorAndExit(e.message || String(e))
}
