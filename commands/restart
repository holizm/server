#!/usr/bin/env node

import { pathToFileURL } from 'url'
import extract from '../scripts/extract.js'
import {
    divide,
    info,
    warning,
} from '../scripts/logger.js'
import {
    getDirs,
    isFile,
} from '../scripts/os.js'
import { runOnTerminal } from '../scripts/terminal.js'

const restartProcess = params => {
    const {
        composeFile,
        fullProcessName,
        lowercaseGitHubImageNameOrProcess,
        lowercaseInstance,
        packageFile,
        processPath,
    } = params

    divide()
    info(`Restarting ${params.process}`)
    divide()

    if (isFile(packageFile) || isFile(`${processPath}/index.html`)) {
        const pid = runOnTerminal(`pm2 pid ${fullProcessName}`, false, true).trim()
        if (pid && pid !== '0') {
            runOnTerminal(`pm2 restart ${fullProcessName} --update-env`, true)
            return
        }
        runOnTerminal(`cd '${processPath}' && start`, true)
        return
    }

    if (isFile(composeFile)) {
        const compose = `docker compose -p ${lowercaseInstance}-${lowercaseGitHubImageNameOrProcess} -f '${composeFile}'`
        const runningContainers = runOnTerminal(`${compose} ps -q --status running`, false, true)
        if (runningContainers) {
            runOnTerminal(`${compose} restart`, true)
            return
        }
        runOnTerminal(`cd '${processPath}' && start`, true)
        return
    }

    warning('What to restart?')
}

const restart = params => {
    const resolved = extract(params)
    if (resolved.level === 'process') {
        restartProcess(resolved)
        return
    }

    const directories = getDirs().filter(directory => {
        if (!params.filter) return true
        return new RegExp(params.filter).test(directory)
    })
    for (const directory of directories) {
        const directoryPath = `${resolved.instancePath}/${directory}`
        const processParams = extract({ directoryPath })
        if (
            isFile(processParams.packageFile)
            || isFile(`${processParams.processPath}/index.html`)
            || isFile(processParams.composeFile)
        ) {
            restartProcess(processParams)
        }
    }
}

const isMain = import.meta.url === pathToFileURL(process.argv[1]).href
if (isMain) {
    restart({
        directoryPath: process.cwd(),
        filter: process.argv[2] || '',
    })
}
