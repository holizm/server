#!/usr/bin/env node

import os from 'os'
import { runOnTerminal } from '../scripts/terminal.js'
import { info } from '../scripts/logger.js'
import extract from '../scripts/extract.js'
import getComposePort from '../scripts/getComposePort.js'
import getListeningPort from '../scripts/getListeningPort.js'
import getReverseProxyPort from '../scripts/getReverseProxyPort.js'

const directoryPath = process.cwd()

const home = directoryPath.startsWith('/home/')
    ?
    '/' + directoryPath.split('/').slice(1, 3).join('/')
    :
    os.homedir()
let params = {
    directoryPath,
    home,
}
params = extract(params)

const {
    fullProcessName,
} = params

const processPort = getComposePort(params)
const {
    reverseProxyPort,
    runningReverseProxyPort,
} = getReverseProxyPort(params)

const user = home.slice('/home/'.length)
let command = `su - ${user} -c 'pm2 pid ${fullProcessName}' | awk '/^[0-9]+$/ {print; exit}'`
const pid = runOnTerminal(command).trim()

const runningProcessPort = getListeningPort(pid)

info(`${fullProcessName}`)
info(`runningReverseProxyPort: ${runningReverseProxyPort}`)
info(`reverseProxyPort: ${reverseProxyPort}`)
info(`runningProcessPort: ${runningProcessPort}`)
info(`processPort: ${processPort}`)
