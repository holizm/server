#!/usr/bin/env bash

set -euo pipefail

if [[ -z "${1:-}" || -z "${2:-}" ]]; then
    printf 'Usage: certificate <name> <san1>,<san2>,...\n' >&2
    exit 1
fi

name="$1"
sanCsv="$2"
read -ra subjectAlternativeNames <<< "${sanCsv//,/ }"

if [[ "${#subjectAlternativeNames[@]}" -eq 0 ]]; then
    printf 'At least one subject alternative name is required\n' >&2
    exit 1
fi

args=(certbot certonly --cert-name "$name")
for subjectAlternativeName in "${subjectAlternativeNames[@]}"; do
    args+=(-d "$subjectAlternativeName")
done

"${args[@]}"
