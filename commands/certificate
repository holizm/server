#!/usr/bin/env bash

. "/holism/server/scripts/logger.sh"

if [[ -z "$1" ]]; then
    error "Error - Please provide the domain argument"
    exit 1
fi

certificatePath="/etc/letsencrypt/live/$1/fullchain.pem"

if [[ ! -f "$certificatePath" ]]; then
    error "Error - Certificate not found: $certificatePath"
    exit 1
fi

subject=$(openssl x509 -in "$certificatePath" -noout -subject | sed 's/^subject=//')
issuer=$(openssl x509 -in "$certificatePath" -noout -issuer | sed 's/^issuer=//')
from=$(openssl x509 -in "$certificatePath" -noout -startdate | sed 's/^notBefore=//')
to=$(openssl x509 -in "$certificatePath" -noout -enddate | sed 's/^notAfter=//')
sans=$(openssl x509 -in "$certificatePath" -noout -ext subjectAltName | sed -n '2,$p' | tr ',' '\n' | sed -E 's/^[[:space:]]*//; s/^DNS://')

info "Certificate Name: $1"
divide
info 'Certificate'
divide
info "Subject: $subject"
info "Issuer: $issuer"
success "From: $from"
warning "To: $to"
divide
info 'Subject Alternative Names'
printf '%s\n' "$sans" | while IFS= read -r san; do
    info "  $san"
done
