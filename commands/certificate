#!/usr/bin/env bash

if [[ -z "$1" ]]; then
    echo "Error - Please provide the domain argument"
    exit 1
fi

certificatePath="/etc/letsencrypt/live/$1/fullchain.pem"

if [[ ! -f "$certificatePath" ]]; then
    echo "Error - Certificate not found: $certificatePath"
    exit 1
fi

openssl x509 -in "$certificatePath" -noout \
    -subject \
    -issuer \
    -serial \
    -dates \
    -fingerprint -sha256 \
    -ext subjectAltName \
    -text
