#!/usr/bin/env bash
set -euo pipefail

if [[ $(id -u) != 0 ]]; then
    printf '%s\n' 'Run clean as root after connecting with manage.' >&2
    exit 1
fi

exec {lockDescriptor}>/run/holismClean.lock
if ! flock -n "$lockDescriptor"; then
    printf '%s\n' 'Server cleanup is already running.' >&2
    exit 1
fi

scriptDirectory=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../scripts" && pwd)
. "$scriptDirectory/cleanDocker.sh"
status=0
runCleanup() {
    local label=$1
    shift
    printf '\n%s\n' "$label"
    if ! "$@"; then
        printf 'Cleanup failed: %s\n' "$label" >&2
        status=1
    fi
}

df -h /
runCleanup 'Clear downloaded Debian packages' apt-get clean
runCleanup 'Clean expired temporary files' systemd-tmpfiles --clean

if command -v logrotate >/dev/null && [[ -f /etc/logrotate.conf ]]; then
    runCleanup 'Rotate system logs' logrotate /etc/logrotate.conf
fi
runCleanup 'Remove journal archives older than 14 days' journalctl --rotate --vacuum-time=14d

runCleanup 'Clean the system Docker daemon' cleanDocker /run/docker.sock

accounts=$(getent passwd)
while IFS=: read -r userName password userId groupId description userHome shell; do
    [[ $userHome == /* && $userHome != / && -d $userHome && ! -L $userHome ]] || continue
    [[ $(stat -c %u -- "$userHome") == "$userId" ]] || continue
    runCleanup "Clean caches and stale logs for $userName" \
        runuser --user "$userName" -- bash "$scriptDirectory/cleanUserFiles.sh" "$userHome"
done <<< "$accounts"

printf '\n%s\n' 'Disk usage after cleanup'
df -h /
exit "$status"
