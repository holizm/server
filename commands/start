#!/usr/bin/env node

import {
    isApi,
    isFile,
    isPanel,
    isSite,
} from '../scripts/os.js'
import extract from '../scripts/extract.js'
import { runOnTerminal } from '../scripts/terminal.js'
import {
    errorAndExit,
    info,
    warning,
} from '../scripts/logger.js'
import getComposePort from '../scripts/getComposePort.js'
import getListeningPort from '../scripts/getListeningPort.js'
import startInstance from '../scripts/startInstance.js'

const startProcess = params => {
    const {
        fullProcessName,
        port,
    } = params
    if (isApi(params)) {
        runOnTerminal(`pm2 start process.js --name ${fullProcessName} --update-env -- ${port}`, true)
    }
    else if (isPanel(params)) {
        runOnTerminal(`pm2 start serve --name ${fullProcessName} -- -s . -l ${port}`, true)
    }
    else if (isSite(params)) {
        runOnTerminal(`PORT=${port} pm2 start server/entry.express.js --name ${fullProcessName}`, true)
    }
    else {
        warning('Unknown process')
        return
    }
}

let params = { directoryPath: process.cwd() }
params = extract(params)
const {
    composeFile,
    githubImageNameOrProcess,
    instance,
    instancePath,
    level,
    lowercaseGitHubImageNameOrProcess,
    lowercaseInstance,
    lowercaseProcess,
    packageFile,
    processPath,
} = params

if (level === 'instance') {
    try {
        startInstance(params, process.argv[2])
    }
    catch (e) {
        errorAndExit(e.message)
    }
} else {
    if (isFile(packageFile) || isFile(`./index.html`)) {
        params.port = getComposePort(params)
        const pid = runOnTerminal(
            `pm2 pid ${params.fullProcessName}`,
            true
        ).trim()

        const listeningPort = getListeningPort(pid)
        const list = runOnTerminal('pm2 list', true)
        const isRunning = list.includes(params.fullProcessName)
        if (!isRunning) {
            startProcess(params)
        }
        else {
            if (params.port === listeningPort) {
                info(`${params.fullProcessName} is already running`)
            }
            else {
                runOnTerminal(`pm2 delete ${params.fullProcessName}`)
                startProcess(params)
            }
        }
        runOnTerminal('pm2 save', true)
    }
    else if (isFile(composeFile)) {

        runOnTerminal('docker system prune --force')
        const command = `docker compose -p ${lowercaseInstance}-${lowercaseGitHubImageNameOrProcess} up --remove-orphans --quiet-pull -d`
        runOnTerminal(command, true)
    }
    else {
        warning('What to start?')
    }
}
