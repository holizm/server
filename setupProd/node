#!/usr/bin/env bash
. "$scripts/installer.sh"
. "$scripts/logger.sh"

useNodeSourceExecutables() {
    local executable

    for executable in node npm npx; do
        if [[ -x "/usr/bin/$executable" ]] && [[ -L "/usr/local/bin/$executable" ]] && [[ "$(readlink "/usr/local/bin/$executable")" == "/usr/local/node/bin/$executable" ]]; then
            ln -sfn "/usr/bin/$executable" "/usr/local/bin/$executable"
        fi
    done

    if [[ -x /usr/bin/node ]]; then
        nodeBinDirectory='/usr/bin'
        export nodeBinDirectory
        export PATH="$nodeBinDirectory:$PATH"
        hash -r
    fi
}

installNode() {
    apt-get update -y
    apt-get install -y curl ca-certificates gnupg jq
    curl -fsSL https://deb.nodesource.com/setup_lts.x | bash -
    apt-get install -y nodejs
    useNodeSourceExecutables

    if ! grep -qxF 'export NODE_OPTIONS="--trace-deprecation"' ~/.bashrc; then
        echo 'export NODE_OPTIONS="--trace-deprecation"' >> ~/.bashrc
    fi
    export NODE_OPTIONS="--trace-deprecation"
}

getInstalledNodeVersion() {
    local nodeExecutable

    nodeExecutable=$(command -v node 2>/dev/null || true)
    if [[ -z "$nodeExecutable" ]] && [[ -x /usr/local/node/bin/node ]]; then
        nodeExecutable='/usr/local/node/bin/node'
    fi
    if [[ -n "$nodeExecutable" ]]; then
        "$nodeExecutable" --version
    fi
}

getLatestNodeLtsVersion() {
    curl -fsSL https://nodejs.org/dist/index.json \
        | jq -r '[.[] | select(.lts != false)][0].version'
}

useNodeSourceExecutables
ensureLatestLts node getInstalledNodeVersion getLatestNodeLtsVersion installNode

nodeExecutable=$(command -v node 2>/dev/null || true)
if [[ -z "$nodeExecutable" ]] && [[ -x /usr/local/node/bin/node ]]; then
    nodeExecutable='/usr/local/node/bin/node'
fi
if [[ -z "$nodeExecutable" ]]; then
    errorAndExit 'Node.js executable was not found'
fi
nodeBinDirectory=$(dirname "$(readlink -f "$nodeExecutable")")
export nodeBinDirectory
export PATH="$nodeBinDirectory:$PATH"
