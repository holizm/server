#!/usr/bin/env bash
set -euo pipefail

. "$scripts/installer.sh"

updateApt() {
    info "Updating apt ..."
    apt-get update || error "Failed to update apt"
    check 'Updated apt'
}

setNginxDefaultSite() {
    if mv /etc/nginx/sites-enabled/default /etc/nginx/sites-enabled-default-backup 2>/dev/null; then
        check 'Moved default Nginx site to backup'
    else
        check 'Default Nginx site'
    fi

    local source="/holism/server/webServer/default"
    local target="/etc/nginx/conf.d/default.conf"

    if [ -L "$target" ] && [ "$(readlink -f "$target")" = "$(readlink -f "$source")" ]; then
        check 'Nginx default link already exists'
    else
        ln -sfn "$source" "$target"
        nginx -s reload
        check 'Linked Nginx default site'
    fi
}

registerHolismCommands() {
    local bashLine='export PATH="/holism/server/commands:$PATH"'
    local environmentLine="PATH=\"/holism/server/commands:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$nodeBinDirectory\""

    if grep -Fq '/holism/server/commands' /etc/environment; then
        sed -i "\|/holism/server/commands|c\\$environmentLine" /etc/environment
    else
        chmod 644 /etc/environment
        printf '%s\n' "$environmentLine" | tee -a /etc/environment > /dev/null
    fi
    if grep -Fq '/holism/server/commands' /etc/bash.bashrc; then
        sed -i "\|/holism/server/commands|c\\$bashLine" /etc/bash.bashrc
    else
        chmod 644 /etc/bash.bashrc
        printf '%s\n' "$bashLine" | tee -a /etc/bash.bashrc > /dev/null
    fi
    check 'Registered Holism commands'
}

setTimeZone() {
    if timedatectl | grep -q "Time zone: UTC"; then
        check 'Time Zone'
        return
    fi
    info "Configuring Time Zone to UTC ..."
    timedatectl set-timezone UTC || error "Failed to set time zone"
    check 'Configured Time Zone to UTC'
}

addSbinToUserPath() {
    local file="/etc/bash.bashrc"
    local line='export PATH=$PATH:/usr/sbin'

    if ! grep -Fxq "$line" "$file"; then
        echo "$line" | tee -a "$file" > /dev/null
        check "/usr/sbin added to PATH in $file"
    fi
}

if [[ -f /etc/apt/sources.list.d/nginx.list ]]; then
    "$setupProd/nginxRepositoryKey"
fi

updateApt

install curl
install crontab cron
install git
install jq
install nethogs
install rsync
install telnet
install unzip
install zip

$setupProd/apiDependencies

$setupProd/nginx
$setupProd/certbot
$setupProd/htpasswd
setNginxDefaultSite

$setupProd/micro
$setupProd/rclone

# $setupProd/az
$setupProd/az
# $setupProd/azcopy

$setupProd/docker

source "$setupProd/node"
"$setupProd/configureNginxHash"
$setupProd/pm2
npm install -g --registry='https://registry.npmjs.org' serve

registerHolismCommands
setTimeZone
source "$setupProd/normalizeShells.sh"
addSbinToUserPath

source "$setupProd/secureUsers.sh"
source "$setupProd/setPermissions.sh"
$setupProd/includeUpdateTerminalTitleConfig.js
