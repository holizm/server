services:
    cacheServer:
        image: redis:latest
        container_name: ${instance}Cache
        hostname: ${instance}Cache
        command:
            - redis-server
            - --requirepass
            - ${cacheServerPassword}
        ports:
            - 127.0.0.1:${deterministicPort}:6379
        networks:
            - ${instance}Network
        restart: always
        healthcheck:
            test: ["CMD", "redis-cli", "--no-auth-warning", "-a", "${cacheServerPassword}", "PING"]
            interval: 5s
            timeout: 5s
            retries: 5

networks:
    ${instance}Network:
        name: ${instance}Network
        driver: bridge
