services:
    cache:
        image: redis:latest
        container_name: ${instance}Cache
        hostname: ${instance}Cache
        command:
            - redis-server
            - --requirepass
            - ${cachePassword}
            - --save
            - ""
            - --appendonly
            - "no"
        ports:
            - ${deterministicPort}:6379
        logging:
            driver: none
        networks:
            - ${instance}Network
        restart: always
        healthcheck:
            test: ["CMD", "redis-cli", "-a", "${cachePassword}", "PING"]
            interval: 5s
            timeout: 5s
            retries: 5

networks:
    ${instance}Network:
        name: ${instance}Network
        driver: bridge
