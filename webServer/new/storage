map {host} {storageTenant} {
    import ${home}/${instance}/webServer/storageTenantHosts
    default ""
}

@storageHost header_regexp Host ^storage\..+$
handle @storageHost {
    @knownTenant expression `{storageTenant} != ""`
    handle @knownTenant {
        root * ${storageRoot}/{storageTenant}
        header Cache-Control "public, max-age=31536000, immutable"
        @robots path /robots.txt
        handle @robots {
            header Content-Type text/plain
            respond "User-agent: *\nDisallow: /image/\nDisallow: /property/" 200
        }
        @extensionless path_regexp ^/[^.]+$
        @image path_regexp image ^(.*)\.webp$
        @audio path_regexp audio ^(.*)\.mp3$
        @video path_regexp video ^(.*)\.mp4$
        @file path_regexp \.[^/]+$
        header @file Access-Control-Allow-Origin *
        route {
            rewrite @extensionless {path}.webp
            file_server {
                pass_thru
            }
            handle @image {
                rewrite * /image/resize{re.image.1}
                reverse_proxy 127.0.0.1:${storageApiPort}
            }
            handle @audio {
                rewrite * /audio/stream{re.audio.1}
                reverse_proxy 127.0.0.1:${storageApiPort}
            }
            handle @video {
                rewrite * /video/stream{re.video.1}
                reverse_proxy 127.0.0.1:${storageApiPort}
            }
            handle {
                rewrite * /file/get{path}
                reverse_proxy 127.0.0.1:${storageApiPort}
            }
        }
    }
    handle {
        respond 404
    }
}
